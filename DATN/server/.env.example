# ============ Server ============
NODE_ENV=development
PORT=5000

# URL của frontend, dùng cho CORS
CLIENT_URL=http://localhost:5173

# ============ Database ============
# Dev: MySQL chạy bằng docker compose ở port 3308
DATABASE_URL="mysql://root:noithat123@localhost:3308/noithat"

# ============ Auth ============
JWT_SECRET=doi-chuoi-nay-thanh-mot-chuoi-random-dai-tren-32-ky-tu
JWT_EXPIRES_IN=7d

# ============ Lưu ảnh ============
# local = ghi vào server/public/uploads | cloudinary = đẩy lên Cloudinary
STORAGE_DRIVER=local

# Chỉ cần khi STORAGE_DRIVER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ============ SePay: tự động xác nhận chuyển khoản ============
# Khoá tự đặt, phải trùng với ô "API Key" khi tạo webhook ở my.sepay.vn.
# Để trống thì endpoint webhook TỪ CHỐI mọi request (fail-closed) — nếu không
# ai cũng có thể giả webhook để đánh dấu đơn đã thanh toán.
SEPAY_WEBHOOK_API_KEY=

# Tài khoản nhận tiền, dùng để sinh mã QR VietQR.
# Tên ngân hàng viết theo chuẩn VietQR: MBBank, Vietcombank, ACB, Techcombank...
SEPAY_BANK_ACCOUNT=
SEPAY_BANK_CODE=
SEPAY_ACCOUNT_NAME=
